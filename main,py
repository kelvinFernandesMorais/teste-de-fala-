print("Este aplicativo vai testar sua habilidade em outros idiomas. No caso são inglês e espanhol")

while True:
    erros = 0
    pontuação = 0
    
    escolha = input("\nEscolha o nível: \n[f] Fácil \n[m] Médio \n[d] Difícil \n[g] Gírias \nSua escolha: ").strip().lower()
    mapeamento = {"f": "facil", "m": "medio", "d": "dificil", "g": "girias"}
    categoria = mapeamento.get(escolha, "facil")

    palavras_disponiveis = list(palavras[categoria])

    while erros < 3:
        if not palavras_disponiveis:
            print("\n🎉 Você passou por todas as palavras! Reiniciando a lista...")
            palavras_disponiveis = list(palavras[categoria])

        palavras_rodada = random.choice(palavras_disponiveis)
        palavras_disponiveis.remove(palavras_rodada)

        print("\n========================================")
        print(f"Como se diz e pronuncia '{palavras_rodada['portugues']}' em inglês?")
        print(f"Erros: {erros}/3 | Restantes na lista: {len(palavras_disponiveis)}")
        print("========================================")

        input("Pressione ENTER e prepare-se para falar...")
        print("Fale agora...")

        recording = sd.rec(
            int(duration * sample_rate),
            samplerate=sample_rate,
            channels=1,
            dtype='int16'
        )
        sd.wait()  
        print("Gravação concluída, processando sua pronúncia...")

        wav.write("output.wav", sample_rate, recording)

        recognizer = sr.Recognizer()
        with sr.AudioFile("output.wav") as source:
            audio = recognizer.record(source)
            
        try:
            resposta_usuario = recognizer.recognize_google(audio, language="en-US").strip().lower()
            resposta_correta = palavras_rodada['ingles'].lower()
            
            print(f"\nVocê pronunciou: '{resposta_usuario}'")
            print(f"Palavra esperada: '{resposta_correta}'")
            
            if resposta_usuario == resposta_correta:
                print("✨ Excelente! Pronúncia correta! ✨")
                pontuação += 1
            else:
                print("❌ A pronúncia não foi idêntica.")
                erros += 1
                
        except sr.UnknownValueError:
            print("\nNão consegui entender o áudio. Conta como erro.")
            erros += 1
        except sr.RequestError:
            print("\nErro de conexão com o serviço de voz.")

        print(f"Pontuação atual: {pontuação}")

    print(f"\n========================================")
    print(f"Fim de jogo! Você errou 3 vezes.")
